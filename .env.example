# Copy to .env and fill in. Only needed for live mode; .env is gitignored.

# Google Gemini API key
GEMINI_API_KEY=

# Agent wallet on Base (written by scripts/setup_flashpoint_wallet.py).
# The private key must be the key for FLASHPOINT_WALLET_ADDRESS.
FLASHPOINT_WALLET_ADDRESS=
FLASHPOINT_PRIVATE_KEY=

# Optional: only for the Claude scorer in src/sampler/claude_scorer.py
ANTHROPIC_API_KEY=
